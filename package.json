{
  "name": "pi-must-have-extension",
  "version": "0.5.0",
  "description": "RFC 2119 keyword normalizer extension for the Pi coding agent.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "asset",
    "config/config.example.jsonc",
    "config/replacements.custom-sample.jsonc",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run build",
    "test": "node --experimental-strip-types --test test/**/*.test.ts",
    "check": "npm run lint && npm run test",
    "postinstall": "node -e \"const fs=require('fs'),cp=require('child_process'),p=require('path');const cwd=process.cwd();const normalized=cwd.split(p.sep).join('/');if(!normalized.includes('/.pi/agent/extensions/'))process.exit(0);const s=p.resolve(cwd,'../../scripts/patch-vulnerable-deps.mjs');if(!fs.existsSync(s))process.exit(0);const r=cp.spawnSync(process.execPath,[s,'--target',cwd,'--quiet'],{stdio:'inherit'});process.exit(r.status||0)\""
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "coding-agent",
    "rfc2119",
    "rfc8174",
    "bcp14",
    "prompt-normalization",
    "prompt-rewrite",
    "prompt-engineering",
    "keyword-normalization",
    "compliance",
    "jsonc"
  ],
  "author": "MasuRii",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasuRii/pi-must-have-extension.git"
  },
  "homepage": "https://github.com/MasuRii/pi-must-have-extension#readme",
  "bugs": {
    "url": "https://github.com/MasuRii/pi-must-have-extension/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0 || ^0.75.0 || ^0.78.0 || ^0.79.0 || ^0.80.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "@earendil-works/pi-coding-agent": "^0.80.3"
  },
  "overrides": {
    "protobufjs": "7.6.3",
    "ws": "8.21.0"
  }
}
